{
  "name": "chem-units",
  "version": "2.2.0",
  "type": "module",
  "main": "dist/main.umd.cjs",
  "module": "dist/main.js",
  "exports": {
    ".": {
      "import": "./dist/main.js",
      "require": "./dist/main.umd.cjs"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    }
  },
  "description": "A JavaScript library for converting between different units of measurement commonly used in chemistry",
  "author": "Chia-Lin Lin",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LabIMotion/chem-units.git"
  },
  "bugs": {
    "url": "https://github.com/LabIMotion/chem-units/issues"
  },
  "homepage": "https://github.com/LabIMotion/chem-units#readme",
  "engines": {
    "node": ">=21.0.0"
  },
  "files": [
    "dist/main*",
    "dist/engine*"
  ],
  "keywords": [
    "chemistry",
    "system units",
    "unit conversion",
    "nfdi4chem",
    "labimotion",
    "measurement"
  ],
  "scripts": {
    "dev": "vite",
    "prebuild": "yarn clean",
    "build": "vite build --mode esm && vite build --mode engine && vite build --mode umd",
    "prepublishOnly": "yarn build",
    "build:playground": "vite build --mode playground",
    "preview:playground": "vite preview --mode playground --outDir playground-dist",
    "clean": "rm -rf dist temp-test/esm-import-test*",
    "pretest": "yarn build",
    "test": "vitest run --coverage && yarn test:imports",
    "test:imports": "node ./__tests__/validate-imports.js",
    "test:unit": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "mathjs": "^15.0.0"
  },
  "peerDependenciesMeta": {
    "mathjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/eslint-plugin": "^1.6.17",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^17.17.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^17.0.0",
    "mathjs": "^15.2.0",
    "prettier": "^3.5.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.1"
  }
}
